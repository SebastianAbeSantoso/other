            <column caption='Quality Score Difference' datatype='integer' name='[Calculation_2012436024520709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(&#13;&#10;    { FIXED [model_name], [prompt_id] :&#13;&#10;        MAX(IF [run_id] = &quot;run-1&quot; THEN [quality_score] END)&#13;&#10;    }&#13;&#10;    -&#13;&#10;    { FIXED [model_name], [prompt_id] :&#13;&#10;        MAX(IF [run_id] = &quot;run-2&quot; THEN [quality_score] END)&#13;&#10;    }&#13;&#10;)' />
